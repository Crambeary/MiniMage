{
  "permissions": {
    "allow": [
      "Bash(git push)",
      "Bash(git push -u origin HEAD)",
      "Bash(git push origin HEAD)",
      "Bash(git push -u origin t3/*)",
      "Bash(git push origin t3/*)",
      "Bash(rtk git push)",
      "Bash(rtk git push -u origin HEAD)",
      "Bash(rtk git push origin HEAD)",
      "Bash(rtk git push -u origin t3/*)",
      "Bash(rtk git push origin t3/*)"
    ],
    "ask": [
      "Edit(/.claude/settings*.json)",
      "Edit(~/.claude/settings*.json)"
    ],
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * master)",
      "Bash(git push * HEAD:main*)",
      "Bash(git push * :main*)",
      "Bash(git push * --force*)",
      "Bash(git push * --force-with-lease*)",
      "Bash(git push * -f*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * +*)",
      "Bash(rtk git push * main)",
      "Bash(rtk git push * master)",
      "Bash(rtk git push * HEAD:main*)",
      "Bash(rtk git push * --force*)",
      "Bash(rtk git push * -f*)",
      "Bash(rtk git push --force*)",
      "Bash(rtk git push -f*)"
    ]
  },
  "sandbox": {
    "excludedCommands": [
      "git push",
      "git push -u origin HEAD",
      "git push origin HEAD",
      "git push -u origin t3/*",
      "git push origin t3/*",
      "rtk git push",
      "rtk git push -u origin HEAD",
      "rtk git push origin HEAD",
      "rtk git push -u origin t3/*",
      "rtk git push origin t3/*"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__godot-ai__.*|ReadMcpResourceTool",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/hooks/godot_ai_route.py\""
          }
        ]
      }
    ]
  }
}
